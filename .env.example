# ==============================================================================
# TASKLY 1.0 — CONFIGURACIÓN DE VARIABLES DE ENTORNO (SUPABASE FREE + VERCEL)
# ==============================================================================
# Copia este archivo a `.env` y reemplaza los valores con los de tu proyecto
# gratuito de Supabase (Project Settings -> API).
# NUNCA incluyas `service_role` ni secretos privados en el frontend o repositorio.

SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_publishable_anon_key

# Alias compatibles con Vercel / Next / Flutter Web
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_publishable_anon_key

# Habilitar botón de Google OAuth únicamente cuando el proveedor esté configurado en Supabase Auth
GOOGLE_OAUTH_ENABLED=false
